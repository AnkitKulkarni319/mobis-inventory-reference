<mvc:View
    controllerName="inventorytest.controller.InventoryList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">

    <Page
        id="inventoryListPage"
        title="Inventory List"
        showNavButton="true"
        navButtonPress="onNavBack">

        <content>

            <!-- ===================================================== -->
            <!-- FILTER BAR                                            -->
            <!-- ===================================================== -->

            <fb:FilterBar
                id="inventoryFilterBar"
                useToolbar="true"
                showGoOnFB="true"
                showClearOnFB="true"
                search="onFilterSearch"
                clear="onFilterClear"
                showFilterConfiguration="false">

                <fb:filterGroupItems>

                    <!-- LOCATION FILTER -->
                    <fb:FilterGroupItem
                        id="locationFilterItem"
                        name="Location"
                        label="Location"
                        groupName="inventoryFilters"
                        visibleInFilterBar="true">

                        <fb:control>

                            <Select
                                id="locationFilterSelect"
                                width="100%"
                                selectedKey=""
                                forceSelection="false"
                                change="onLocationFilterChange"
                                items="{inventoryList>/locations}">

                                <!-- EMPTY DEFAULT OPTION -->
                                <core:Item
                                    key=""
                                    text="All Locations"/>

                                <!-- DYNAMIC LOCATIONS -->
                                <core:Item
                                    key="{inventoryList>key}"
                                    text="{inventoryList>text}"/>

                            </Select>

                        </fb:control>

                    </fb:FilterGroupItem>


                    <!-- PART NUMBER FILTER -->
                    <fb:FilterGroupItem
                        id="partFilterItem"
                        name="PartNumber"
                        label="Part No."
                        groupName="inventoryFilters"
                        visibleInFilterBar="true">

                        <fb:control>

                            <Select
                                id="partFilterSelect"
                                width="100%"
                                selectedKey=""
                                forceSelection="false"
                                items="{inventoryList>/filterParts}">

                                <!-- EMPTY DEFAULT OPTION -->
                                <core:Item
                                    key=""
                                    text="All Parts"/>

                                <!-- DYNAMIC PART NUMBERS -->
                                <core:Item
                                    key="{inventoryList>partNumber}"
                                    text="{inventoryList>partNumber}"/>

                            </Select>

                        </fb:control>

                    </fb:FilterGroupItem>

                </fb:filterGroupItems>

            </fb:FilterBar>


            <!-- ===================================================== -->
            <!-- INVENTORY TABLE                                        -->
            <!-- ===================================================== -->

            <Table
                id="invTable"
                growing="true"
                growingThreshold="20"
                noDataText="No inventory records found"
                items="{inventoryList>/items}">

                <columns>

                    <Column>
                        <Text text="Location"/>
                    </Column>

                    <Column>
                        <Text text="Part No."/>
                    </Column>

                    <Column>
                        <Text text="Description"/>
                    </Column>

                    <Column>
                        <Text text="On Hand"/>
                    </Column>

                    <Column>
                        <Text text="Reorder Level"/>
                    </Column>

                    <Column>
                        <Text text="Status"/>
                    </Column>

                </columns>


                <items>

                    <ColumnListItem>

                        <cells>

                            <Text
                                text="{inventoryList>locationName}"/>

                            <Text
                                text="{inventoryList>partNumber}"/>

                            <Text
                                text="{inventoryList>description}"/>

                            <Text
                                text="{inventoryList>quantityOnHand}"/>

                            <Text
                                text="{inventoryList>reorderLevel}"/>

                            <ObjectStatus
                                text="{inventoryList>status}"
                                state="{inventoryList>statusState}"/>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>

        </content>

    </Page>

</mvc:View>