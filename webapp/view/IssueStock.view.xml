
<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    controllerName="inventorytest.controller.IssueStock">

    <Page
        class="pgPage"
        title="Issue Stock"
        showNavButton="true"
        navButtonPress="onNavBack">

        <content>
            <VBox class="pgBody">

                <Text
                    text="Record stock issued from a warehouse to a service order or customer."
                    class="pgIntro"/>

                <!-- ISSUE STOCK FORM -->
                <VBox class="pgCard">

                    <Toolbar class="dashPanelToolbar">
                        <core:Icon
                            src="sap-icon://outbox"
                            class="panelHeaderIcon"/>

                        <Title
                            text="Issue Details"
                            level="H3"
                            class="sapUiTinyMarginBegin"/>
                    </Toolbar>

                    <f:SimpleForm
                        class="pgForm"
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="12"
                        labelSpanL="12"
                        labelSpanM="12"
                        labelSpanS="12"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="1">

                        <core:Title
                            text="1 · Stock Source &amp; Part Details"/>

                        <Label text="From Warehouse"/>

                        <Select
                            id="issueLocSelect"
                            width="100%"
                            items="{/Locations}"
                            forceSelection="false"
                            change="onLocationChange">

                            <core:Item
                                key="{ID}"
                                text="{name} ({locationCode})"/>
                        </Select>

                        <Label text="Spare Part"/>

                        <Select
                            id="issuePartSelect"
                            width="100%"
                            items="{issueParts>/items}"
                            forceSelection="false">

                            <core:Item
                                key="{issueParts>ID}"
                                text="{issueParts>partNumber} — {issueParts>description}"/>
                        </Select>

                        <core:Title
                            text="2 · Issue Quantity &amp; Reference"/>

                        <Label text="Quantity"/>

                        <Input
                            id="issueQtyInput"
                            type="Number"
                            placeholder="e.g. 5"/>

                        <Label text="Reference"/>

                        <Input
                            id="issueRefInput"
                            placeholder="e.g. Service Order SO-2001"/>

                        <Label
                            text="Service Center"
                            required="true"/>

                        <Select
                            id="issueServiceCenterSelect"
                            width="100%"
                            forceSelection="false"
                            selectedKey=""
                            items="{
                                path: '/ServiceCenters',
                                filters: [{
                                    path: 'isActive',
                                    operator: 'EQ',
                                    value1: true
                                }]
                            }">

                            <core:Item
                                key="{ID}"
                                text="{name} ({serviceCenterCode})"/>
                        </Select>

                    </f:SimpleForm>

                    <HBox
                        justifyContent="End"
                        class="pgActions">

                        <Button
                            text="Cancel"
                            press="onNavBack"/>

                        <Button
                            text="Issue Stock"
                            icon="sap-icon://outbox"
                            type="Emphasized"
                            class="pgPrimaryBtn"
                            press="onIssueStock"/>
                    </HBox>

                </VBox>

                <!-- SERVICE CENTER ISSUES & RECONCILIATION -->
                <VBox class="pgCard">

                    <Toolbar class="dashPanelToolbar">

                        <core:Icon
                            src="sap-icon://action-settings"
                            class="panelHeaderIcon"/>

                        <Title
                            text="Service Center Issues &amp; Reconciliation"
                            level="H3"
                            class="sapUiTinyMarginBegin"/>

                        <ToolbarSpacer/>

                        <Button
                            icon="sap-icon://refresh"
                            type="Transparent"
                            tooltip="Refresh service center issues"
                            press="onRefreshServiceIssues"/>
                    </Toolbar>

                    <Table
                        id="serviceIssuesTable"
                        class="recentTable"
                        growing="true"
                        growingThreshold="10"
                        noDataText="No service center issues found"
                        items="{serviceIssues>/items}">

                        <columns>
                            <Column>
                                <Text text="Service Center"/>
                            </Column>

                            <Column
                                minScreenWidth="Tablet"
                                demandPopin="true">
                                <Text text="Part"/>
                            </Column>

                            <Column
                                minScreenWidth="Desktop"
                                demandPopin="true">
                                <Text text="Warehouse"/>
                            </Column>

                            <Column hAlign="End">
                                <Text text="Issued"/>
                            </Column>

                            <Column
                                hAlign="End"
                                minScreenWidth="Tablet"
                                demandPopin="true">
                                <Text text="Consumed"/>
                            </Column>

                            <Column
                                hAlign="End"
                                minScreenWidth="Tablet"
                                demandPopin="true">
                                <Text text="Returned"/>
                            </Column>

                            <Column
                                hAlign="End"
                                minScreenWidth="Tablet"
                                demandPopin="true">
                                <Text text="Defective"/>
                            </Column>

                            <Column>
                                <Text text="Status"/>
                            </Column>

                            <Column
                                minScreenWidth="Desktop"
                                demandPopin="true">
                                <Text text="Issued On"/>
                            </Column>

                            <Column hAlign="Center">
                                <Text text="Action"/>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem>
                                <cells>

                                    <ObjectIdentifier
                                        title="{serviceIssues>serviceCenter}"
                                        text="{serviceIssues>serviceCenterCode}"/>

                                    <ObjectIdentifier
                                        title="{serviceIssues>partNumber}"
                                        text="{serviceIssues>description}"/>

                                    <Text
                                        text="{serviceIssues>warehouse}"/>

                                    <Text
                                        text="{serviceIssues>issuedQuantity}"/>

                                    <Text
                                        text="{serviceIssues>consumedQuantity}"/>

                                    <Text
                                        text="{serviceIssues>unusedReturnedQuantity}"/>

                                    <Text
                                        text="{serviceIssues>defectiveReturnedQuantity}"/>

                                    <ObjectStatus
                                        text="{serviceIssues>status}"
                                        state="{= ${serviceIssues>status} === 'RECONCILED' ? 'Success' : 'Warning'}"/>

                                    <Text
                                        text="{serviceIssues>dateTime}"/>

                                    <Button
                                        text="Reconcile"
                                        icon="sap-icon://accept"
                                        type="Emphasized"
                                        visible="{= ${serviceIssues>status} === 'ISSUED'}"
                                        press="onReconcilePress"/>

                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>

                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
