<mvc:View
    controllerName="inventorytest.controller.IssueStock"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns="sap.m">

    <Page
        class="pgPage"
        title="Issue Stock"
        showNavButton="true"
        navButtonPress="onNavBack">

        <content>

            <VBox class="pgBody">

                <Text
                    text="Record stock issued from a warehouse to a service order or customer."
                    class="pgIntro"/>

                <!-- ISSUE STOCK FORM -->
                <VBox class="pgCard">

                    <Toolbar class="dashPanelToolbar">
                        <core:Icon src="sap-icon://outbox" class="panelHeaderIcon"/>
                        <Title text="Issue Details" level="H3" class="sapUiTinyMarginBegin"/>
                    </Toolbar>

                    <f:SimpleForm
                        class="pgForm"
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="12"
                        labelSpanL="12"
                        labelSpanM="12"
                        labelSpanS="12"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="1">

                        <core:Title text="1 · Stock Source &amp; Part Details"/>

                        <Label
                            text="From Warehouse"/>

                        <Select
                            id="issueLocSelect"
                            width="100%"
                            items="{/Locations}"
                            forceSelection="false"
                            change="onLocationChange">

                            <core:Item
                                key="{ID}"
                                text="{name} ({locationCode})"/>

                        </Select>


                        <Label
                            text="Spare Part"/>

                        <Select
                            id="issuePartSelect"
                            width="100%"
                            items="{issueParts>/items}"
                            forceSelection="false">

                            <core:Item
                                key="{issueParts>ID}"
                                text="{issueParts>partNumber} — {issueParts>description}"/>

                        </Select>


                        <core:Title text="2 · Issue Quantity &amp; Reference"/>

                        <Label
                            text="Quantity"/>

                        <Input
                            id="issueQtyInput"
                            type="Number"
                            placeholder="e.g. 5"/>


                        <Label
                            text="Reference"/>

                        <Input
                            id="issueRefInput"
                            placeholder="e.g. Service Order SO-2001"/>

                    </f:SimpleForm>

                    <HBox justifyContent="End" class="pgActions">

                        <Button
                            text="Cancel"
                            press="onNavBack"/>

                        <Button
                            text="Issue Stock"
                            icon="sap-icon://outbox"
                            type="Emphasized"
                            class="pgPrimaryBtn"
                            press="onIssueStock"/>

                    </HBox>

                </VBox>


                <!-- RECENT STOCK ISSUES -->
                <VBox class="pgCard">

                    <Toolbar class="dashPanelToolbar">

                        <core:Icon
                            src="sap-icon://history"
                            class="panelHeaderIcon"/>

                        <Title
                            text="Recent Stock Issues"
                            level="H3"
                            class="sapUiTinyMarginBegin"/>

                        <ToolbarSpacer/>

                        <Button
                            icon="sap-icon://refresh"
                            type="Transparent"
                            tooltip="Refresh recent stock issues"
                            press="onRefreshRecentIssues"/>

                    </Toolbar>


                    <fb:FilterBar
                        id="issueFilterBar"
                        useToolbar="true"
                        showGoOnFB="true"
                        showClearOnFB="true"
                        search="onFilterSearch"
                        clear="onFilterClear"
                        showFilterConfiguration="false">

                        <fb:filterGroupItems>

                            <!-- LOCATION FILTER -->
                            <fb:FilterGroupItem
                                id="issueLocationFilterItem"
                                name="IssueLocation"
                                label="Location"
                                groupName="issueFilters"
                                visibleInFilterBar="true">

                                <fb:control>

                                    <Select
                                        id="issueLocationFilterSelect"
                                        width="100%"
                                        selectedKey=""
                                        forceSelection="false"
                                        change="onIssueFilterLocationChange"
                                        items="{recentIssues>/locations}">

                                        <core:Item
                                            key=""
                                            text="All Locations"/>

                                        <core:Item
                                            key="{recentIssues>key}"
                                            text="{recentIssues>text}"/>

                                    </Select>

                                </fb:control>

                            </fb:FilterGroupItem>


                            <!-- PART NUMBER FILTER -->
                            <fb:FilterGroupItem
                                id="issuePartFilterItem"
                                name="IssuePartNumber"
                                label="Part No."
                                groupName="issueFilters"
                                visibleInFilterBar="true">

                                <fb:control>

                                    <Select
                                        id="issuePartFilterSelect"
                                        width="100%"
                                        selectedKey=""
                                        forceSelection="false"
                                        items="{recentIssues>/filterParts}">

                                        <core:Item
                                            key=""
                                            text="All Parts"/>

                                        <core:Item
                                            key="{recentIssues>partNumber}"
                                            text="{recentIssues>partNumber}"/>

                                    </Select>

                                </fb:control>

                            </fb:FilterGroupItem>

                        </fb:filterGroupItems>

                    </fb:FilterBar>


                    <Table
                        id="issueRecentIssuesTable"
                        class="recentTable"
                        growing="true"
                        growingThreshold="10"
                        noDataText="No stock issues found"
                        items="{recentIssues>/items}">

                        <columns>

                            <Column>
                                <Text text="Part Number"/>
                            </Column>

                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Description"/>
                            </Column>

                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Location"/>
                            </Column>

                            <Column hAlign="End">
                                <Text text="Quantity"/>
                            </Column>

                            <Column minScreenWidth="Desktop" demandPopin="true">
                                <Text text="Reference"/>
                            </Column>

                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="Date / Time"/>
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem>

                                <cells>

                                    <ObjectIdentifier
                                        title="{recentIssues>partNumber}"/>

                                    <Text
                                        text="{recentIssues>description}"/>

                                    <Text
                                        text="{recentIssues>location}"/>

                                    <ObjectNumber
                                        number="{recentIssues>quantity}"
                                        unit="units"
                                        emphasized="true"
                                        state="Information"/>

                                    <Text
                                        text="{recentIssues>reference}"/>

                                    <Text
                                        text="{recentIssues>dateTime}"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>